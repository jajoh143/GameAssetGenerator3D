# Copy to .env and fill in your values.

# OpenAI Images (gpt-image-1) — used when --prompt is given
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Local TRELLIS.2 install
TRELLIS2_PATH=/opt/TRELLIS.2
TRELLIS2_PYTHON=/opt/conda/envs/trellis2/bin/python
TRELLIS2_MODEL_ID=microsoft/TRELLIS.2-4B

# Blender (3.6+ recommended)
BLENDER_PATH=blender

# Where intermediate images and raw TRELLIS GLBs are stored
GAG3D_WORK_DIR=assets/output
